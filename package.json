{
  "name": "jemaos-usb-quota-gui",
  "version": "0.1.14",
  "private": true,
  "description": "Cross-platform tool to provision the signed JemaOS USB installation quota (Linux / macOS / Windows)",
  "license": "BSD-3-Clause",
  "author": {
    "name": "JemaOS",
    "email": "dev@jematech.fr"
  },
  "homepage": "https://github.com/JemaOS/jemaos-usb-quota-gui",
  "main": "electron/main.js",
  "bin": {
    "jemaos-quota": "bin/jemaos-quota.js"
  },
  "scripts": {
    "prestart": "npm run icons",
    "start": "node scripts/start-native.js",
    "cli": "node bin/jemaos-quota.js",
    "test": "node --test",
    "icons": "node scripts/generate-icons.js",
    "predist": "npm run icons",
    "dist": "electron-builder",
    "dist:linux": "npm run dist -- --linux AppImage deb --publish never",
    "dist:win": "npm run dist -- --win nsis --x64 --publish never",
    "dist:win:portable": "npm run dist -- --win portable --x64 --publish never",
    "dist:mac": "npm run dist -- --mac dmg --x64 --arm64 --publish never",
    "dist:mac:dir": "npm run dist -- --mac dir --x64 --arm64 --publish never",
    "dist:mac:linux": "bash scripts/dist-macos-on-linux.sh",
    "dist:win:zip": "bash scripts/dist-win-zip.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.0.5",
    "@resvg/resvg-js": "2.6.2",
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "fr.jematech.jemaos.quota",
    "productName": "Quota JemaOS",
    "executableName": "quota-jemaos",
    "afterPack": "scripts/afterPack.js",
    "asar": true,
    "electronVersion": "31.7.7",
    "files": [
      "bin/jemaos-quota-priv.js",
      "bin/jemaos-quota.js",
      "src/**",
      "ui/**",
      "resources/**",
      "assets/icon.png",
      "electron/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "JemaOS <dev@jematech.fr>",
      "icon": "assets/linux",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "sign": "scripts/sign-mac.js",
      "artifactName": "Quota-JemaOS-${version}-macos-${arch}.dmg",
      "extendInfo": {
        "NSRemovableVolumesUsageDescription": "Quota JemaOS reads and initializes the signed installation quota on your selected USB key."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "Quota-JemaOS-${version}-windows-${arch}-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quota JemaOS",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Quota-JemaOS-${version}-windows-${arch}-Portable.exe"
    },
    "appImage": {
      "artifactName": "Quota-JemaOS-${version}-linux-${arch}.AppImage"
    },
    "asarUnpack": [
      "bin/**",
      "resources/**",
      "src/**"
    ]
  }
}
